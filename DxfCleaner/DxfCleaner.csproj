<Project Sdk="Microsoft.NET.Sdk">

  <!-- Отдельная, НЕ зависящая от Revit/AutoCAD утилита — чистит DXF-мозаику армирования
       из ЛИРА (лишние слои + подписи As не по центру КЭ) до того, как файл попадёт в
       AutoCAD на ручную проверку или в плагин на импорт. Не входит в DAN_Plugin.sln —
       собирается отдельно через dotnet build/publish, как и DAN_Plugin2026.csproj. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <OutputType>WinExe</OutputType>
    <RootNamespace>DxfCleaner</RootNamespace>
    <AssemblyName>DxfCleaner</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

</Project>
