<Window x:Class="DxfCleaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DXF Cleaner — очистка мозаики армирования ЛИРА"
        Height="520" Width="680"
        Background="#14171C"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Foreground="#DDE4EC" FontSize="15" FontWeight="Bold"
                   Text="Очистка DXF-мозаики армирования (ЛИРА)" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" Foreground="#8B96A5" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="Убирает слои вне layer_elements/layer_result_values/layer_result_palette и переставляет подписи As точно в центр их конечного элемента (высота подписи — 0.1). Можно выбрать сразу несколько файлов. Внимание: каждый файл ПЕРЕЗАПИСЫВАЕТСЯ на месте, отдельная копия не создаётся."/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="BtnBrowse" Content="Выбрать DXF…" Padding="12,7" Click="BtnBrowse_Click"/>
            <TextBlock x:Name="TxtPath" Foreground="#8B96A5" VerticalAlignment="Center" Margin="12,0,0,0"
                       Text="Файлы не выбраны — можно перетащить один или несколько .dxf в это окно" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <Button Grid.Row="3" x:Name="BtnClean" Content="Очистить" Padding="16,8" HorizontalAlignment="Left"
                FontWeight="Bold" IsEnabled="False" Click="BtnClean_Click" Margin="0,0,0,12"/>

        <TextBox Grid.Row="4" x:Name="TxtLog" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="12"
                 Background="#1B2027" Foreground="#DDE4EC" BorderBrush="#2C343F" Padding="10"/>
    </Grid>
</Window>
