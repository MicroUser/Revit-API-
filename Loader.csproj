<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props"
          Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{A1B2C3D4-E5F6-7890-ABCD-EF1234567890}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>MyPlugin.Loader</RootNamespace>
    <AssemblyName>Loader</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
  </PropertyGroup>
  <!-- Тот же Loader, только с вкладкой ленты "LD" вместо "DAN" — см. LD_BRAND в Loader.cs и
       Installer/DAN_Plugin_Combined_LD.iss (собирает отдельный установщик из этого Loader.dll
       + обычного DAN_Plugin.dll из bin\Release, тот же путь установки/manifest). -->
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release-LD|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release-LD\</OutputPath>
    <DefineConstants>LD_BRAND</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="RevitAPI">
      <HintPath>..\..\..\..\..\..\Program Files\Autodesk\Revit 2023\RevitAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>..\..\..\..\..\..\Program Files\Autodesk\Revit 2023\RevitAPIUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System" />
    <Reference Include="WindowsBase" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Loader.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\cells.png" />
    <EmbeddedResource Include="Resources\steel-mesh_32.png" />
    <EmbeddedResource Include="Resources\steel-mesh_16.png" />
    <EmbeddedResource Include="Resources\slab_32.png" />
    <EmbeddedResource Include="Resources\slab_16.png" />
    <EmbeddedResource Include="Resources\dimension_32.png" />
    <EmbeddedResource Include="Resources\dimension_16.png" />
    <EmbeddedResource Include="Resources\Annotation_32.png" />
    <EmbeddedResource Include="Resources\Annotation_16.png" />
    <EmbeddedResource Include="Resources\checklist_32.png" />
    <EmbeddedResource Include="Resources\checklist_16.png" />
    <EmbeddedResource Include="Resources\pencil_32.png" />
    <EmbeddedResource Include="Resources\pencil_16.png" />
    <EmbeddedResource Include="Resources\version-control_32.png" />
    <EmbeddedResource Include="Resources\version-control_16.png" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <!-- Авто-копирование в Addins отключено по просьбе — падало с ошибкой "занят другим
       приложением", когда Revit запущен. Деплой теперь делается вручную/через Add-In Manager. -->
