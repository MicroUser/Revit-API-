    <Exec Command="xcopy /Y &quot;$(TargetPath)&quot; &quot;C:\ProgramData\Autodesk\Revit\Addins\2023\DAN_Plugin\&quot;" ContinueOnError="true" />
  </Target>
  -->
</Project>
