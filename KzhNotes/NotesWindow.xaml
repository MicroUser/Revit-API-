<Window x:Class="KzhNotes.NotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Примечания на листах" Height="720" Width="1040"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="MinWidth" Value="90"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Padding" Value="6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 0: верхняя строка (листы) -->
            <RowDefinition Height="*"/>      <!-- 1: библиотека / выбранные -->
            <RowDefinition Height="Auto"/>   <!-- 2: предпросмотр -->
            <RowDefinition Height="Auto"/>   <!-- 3: наборы -->
            <RowDefinition Height="Auto"/>   <!-- 4: кнопки записи -->
        </Grid.RowDefinitions>

        <!-- Верхняя строка -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Button x:Name="btnRefresh" DockPanel.Dock="Right" Content="Обновить выбор"
                    Click="btnRefresh_Click" MinWidth="130"/>
            <TextBlock x:Name="lblSheets" VerticalAlignment="Center"
                       Text="Листы не выбраны — выделите лист(ы) в диспетчере проекта и нажмите «Обновить выбор»."/>
        </DockPanel>

        <!-- Основная область -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <!-- Библиотека -->
            <GroupBox Grid.Column="0" Header="Библиотека пунктов">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <Button x:Name="btnUpdateLibrary" DockPanel.Dock="Right" Content="Обновить библиотеку"
                                Click="btnUpdateLibrary_Click" MinWidth="150"/>
                        <TextBlock x:Name="lblLibrarySource" VerticalAlignment="Center" Foreground="#888" FontSize="11"/>
                    </DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Text="Группа:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="cboGroup" Width="120" SelectionChanged="Filter_Changed"/>
                        <TextBox x:Name="txtSearch" Margin="6,0,0,0" TextChanged="Filter_Changed"/>
                    </DockPanel>
                    <ListBox x:Name="lstLibrary">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Id}" FontWeight="Bold" Margin="0,0,6,0"/>
                                        <TextBlock Text="⚠ ссылки не вычитаны" Foreground="#B00"
                                                   FontSize="10" VerticalAlignment="Center"
                                                   Visibility="{Binding ReviewWarnVisibility}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" Foreground="#333"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </GroupBox>

            <!-- Кнопки переноса -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0">
                <Button x:Name="btnAdd" Content="Добавить →" Click="btnAdd_Click" Margin="0,0,0,6" MinWidth="110"/>
                <Button x:Name="btnRemove" Content="← Убрать" Click="btnRemove_Click" Margin="0,0,0,20" MinWidth="110"/>
                <Button x:Name="btnUp" Content="Вверх ↑" Click="btnUp_Click" Margin="0,0,0,6" MinWidth="110"/>
                <Button x:Name="btnDown" Content="Вниз ↓" Click="btnDown_Click" MinWidth="110"/>
            </StackPanel>

            <!-- Выбранные + поля -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <GroupBox Grid.Row="0" Header="Выбранные пункты (порядок = нумерация)">
                    <ListBox x:Name="lstSelected" DisplayMemberPath="Display"
                             SelectionChanged="lstSelected_SelectionChanged"/>
                </GroupBox>
                <GroupBox Grid.Row="1" Header="Поля выбранного пункта">
                    <StackPanel x:Name="pnlFields">
                        <TextBlock Text="— выберите пункт с полями —" Foreground="#888"/>
                    </StackPanel>
                </GroupBox>
            </Grid>
        </Grid>

        <!-- Предпросмотр -->
        <GroupBox Grid.Row="2" Header="Предпросмотр (итог с посчитанными ссылками)">
            <StackPanel>
                <TextBox x:Name="txtPreview" IsReadOnly="True" Height="150"
                         VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                         FontFamily="Consolas" Background="#FAFAFA"/>
                <TextBlock x:Name="txtWarnings" Foreground="#B00" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- Наборы -->
        <DockPanel Grid.Row="3" Margin="0,4">
            <TextBlock Text="Набор:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="cboSets" Width="200" DisplayMemberPath="Name"/>
            <Button x:Name="btnApplySet" Content="Применить набор" Click="btnApplySet_Click" Margin="6,0,6,0" MinWidth="130"/>
            <Button x:Name="btnImportSets" Content="Импорт..." Click="btnImportSets_Click" MinWidth="90"/>
            <Separator Width="14" Background="Transparent"/>
            <TextBox x:Name="txtSetName" Width="160" VerticalAlignment="Center"/>
            <Button x:Name="btnSaveSet" Content="Сохранить как набор" Click="btnSaveSet_Click" Margin="6,0,0,0" MinWidth="150"/>
        </DockPanel>

        <!-- Кнопки записи -->
        <DockPanel Grid.Row="4" Margin="0,6,0,0">
            <Button x:Name="btnUpdateAll" DockPanel.Dock="Left" Content="Обновить ссылки на всех листах"
                    Click="btnUpdateAll_Click" MinWidth="230"/>
            <Button x:Name="btnWrite" DockPanel.Dock="Right" Content="Записать"
                    Click="btnWrite_Click" MinWidth="120" FontWeight="Bold"/>
            <TextBlock/>
        </DockPanel>
    </Grid>
</Window>
