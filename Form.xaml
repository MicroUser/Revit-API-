<Window x:Class="DAN_Plugin.Form"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DAN_Plugin"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="300" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Width="297">
    <Grid>
        <TextBlock x:Name="Name_" HorizontalAlignment="Center" Height="28" Margin="0,22,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="192" FontFamily="ISOCPEUR" Text="Впишите марку конструкции" TextAlignment="Center" FontSize="16"/>
        <TextBox x:Name="ConstructionMark" HorizontalAlignment="Center" Height="20" Margin="0,58,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="210" FontFamily="ISOCPEUR"/>
        <Button x:Name="Start_Button" Content="Старт&#xD;&#xA;" HorizontalAlignment="Left" Height="33" Margin="54,287,0,0" VerticalAlignment="Top" Width="201" FontFamily="ISOCPEUR" FontSize="20" FontWeight="Bold" Click="StartButton_Click"/>
        <CheckBox x:Name="Schedule_SA" Content="СА" HorizontalAlignment="Left" Height="15" Margin="45,101,0,0" VerticalAlignment="Top" Width="151" Checked="Schedule_SA_Checked"/>
        <CheckBox x:Name="Schedule_VD" Content="ВД" HorizontalAlignment="Left" Height="14" Margin="45,126,0,0" VerticalAlignment="Top" Width="151" Checked="Schedule_VD_Checked"/>
        <CheckBox x:Name="Schedule_VRS" Content="ВРС" HorizontalAlignment="Left" Height="14" Margin="45,152,0,0" VerticalAlignment="Top" Width="151" Checked="Schedule_VRS_Checked"/>
        <Button x:Name="Cancel_Button" Content="Отмена" HorizontalAlignment="Left" Height="26" Margin="54,333,0,0" VerticalAlignment="Top" Width="201" Click="Cancel_Button_Click" FontFamily="ISOCPEUR" FontSize="20" FontWeight="Bold"/>
        <CheckBox x:Name="Schedule_VM" Content="ВМ" HorizontalAlignment="Left" Height="14" Margin="45,175,0,0" VerticalAlignment="Top" Width="151" Checked="Schedule_VM_Checked"/>
    </Grid>
</Window>
