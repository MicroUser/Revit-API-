<Project>
  <!--
    MSBuildProjectExtensionsPath/BaseIntermediateOutputPath должны быть заданы ДО
    импорта Microsoft.Common.props — единственное надёжное место для этого,
    не трогая сам DAN_Plugin2026.csproj, это Directory.Build.props (см. MSB3540).
    Условие — чтобы не задеть DAN_Plugin.csproj/Loader.csproj (net48, папка "obj\").
    Покрывает ОБА проекта 2026 (DAN_Plugin2026, Loader2026) — раньше условие ловило
    только один из них, и второй (Loader2026) через "obj\" ломал net48-restore.
  -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('2026'))">
    <BaseIntermediateOutputPath>obj2026\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>obj2026\</MSBuildProjectExtensionsPath>
  </PropertyGroup>

  <!-- Тот же приём для AutoCAD+Civil2020.csproj (net48) — делит папку AutoCAD+Civil\ с
       AutoCAD+Civil.csproj (net8.0-windows, AutoCAD 2025), которые без этого делили бы
       общую "obj\" и ломали restore друг друга (см. комментарий выше про MSB3540). -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('2020'))">
    <BaseIntermediateOutputPath>obj2020\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>obj2020\</MSBuildProjectExtensionsPath>
  </PropertyGroup>

  <!--
    Эта машина собирает только через .NET 8 SDK (MSBuild из dotnet), без установленного
    net4.8 Developer/Targeting Pack (MSB3644: "не найдены ссылочные сборки"). Официальный
    обходной путь от Microsoft — пакет Microsoft.NETFramework.ReferenceAssemblies из NuGet,
    не требует прав администратора и не ставится в систему. Затронуты только net48-проекты
    (DAN_Plugin, Loader, AutoCAD+Civil2020) — на машине с нормально установленным net4.8
    Targeting Pack этот пакет просто не понадобится, но и не помешает.
  -->
  <ItemGroup Condition="'$(MSBuildProjectName)'=='DAN_Plugin' or '$(MSBuildProjectName)'=='Loader' or '$(MSBuildProjectName)'=='AutoCAD+Civil2020'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>
</Project>
